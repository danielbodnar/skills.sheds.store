  "font": {
    "family": {
      "primary": {
        "$value": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "$description": "Body. Variable 200-900"
      },
      "secondary": {
        "$value": "Oswald, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "$description": "Headings. Variable 200-700"
      },
      "serif": {
        "$value": "Georgia, \"Iowan Old Style\", \"Times New Roman\", serif",
        "$description": "City page section headings and quotes"
      }
    },
    "size": {
      "$description": "Fluid clamp() between 375px and 1280px viewport, root 16px",
      "small": {
        "min": "14px",
        "max": "15px",
        "leading": "1.5"
      },
      "base": {
        "min": "16px",
        "max": "18px",
        "leading": "1.6"
      },
      "h6": {
        "min": "16px",
        "max": "17px",
        "leading": "1.25"
      },
      "h5": {
        "min": "17px",
        "max": "19px",
        "leading": "1.25"
      },
      "h4": {
