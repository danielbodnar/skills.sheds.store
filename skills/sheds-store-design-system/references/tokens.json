        "max": "22px",
        "leading": "1.25"
      },
      "h3": {
        "min": "22px",
        "max": "28px",
        "leading": "1.15",
        "tracking": "0.015em"
      },
      "h2": {
        "min": "26px",
        "max": "36px",
        "leading": "1.15",
        "tracking": "0.01em"
      },
      "h1": {
        "min": "32px",
        "max": "48px",
        "leading": "1.15",
        "tracking": "0.01em"
